    "schemas": {
      "contact": {
        "type": "object",
        "required": [
          "_id",
          "name",
          "phoneNumber",
          "contactType",
          "userId"
        ],
        "properties": {
          "_id": {
            "description": "Contact's id",
            "type": "string",
            "example": "65e4decdd286b30065d54af9"
          },
          "name": {
            "description": "Contact's name",
            "type": "string",
            "example": "John Doe"
          },
          "phoneNumber": {
            "description": "Contact's phone number",
            "type": "string",
            "example": "+380500000001"
          },
          "email": {
            "description": "Contact's email",
            "type": "string",
            "example": "test@example.com"
          },
          "isFavourite": {
            "description": "Is this contact favourite",
            "type": "boolean",
            "example": true
          },
          "contactType": {
            "description": "Contact's type",
            "type": "string",
            "enum": [
              "personal",
              "home",
              "work"
            ]
          },
          "userId": {
            "description": "User's ID",
            "type": "string",
            "example": "65e4decdd286b30065d54af9"
          },
          "photo": {
            "description": "Link to contact's photo",
            "type": "string",
            "example": "https://res.cloudinary.com/dbnexyque/image/upload/v1745941617/xz0h1qxwsjndiatgmxzp.jpg"
          }
        }
      },
      "user": {
        "type": "object",
        "required": [
          "_id",
          "name",
          "email",
          "password"
        ],
        "properties": {
          "_id": {
            "description": "User's id",
            "type": "string",
            "example": "65e4decdd286b30065d54af9"
          },
          "name": {
            "description": "User's name",
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "description": "User's email",
            "type": "string",
            "example": "test@example.com"
          },
          "password": {
            "description": "User's password",
            "type": "string",
            "example": "password123"
          }
        }
      },
      "session": {
        "type": "object",
        "required": [
          "_id",
          "userId",
          "accessToken",
          "refreshToken",
          "accessTokenValidUntil",
          "refreshTokenValidUntil"
        ],
        "properties": {
          "_id": {
            "description": "Session's id",
            "type": "string",
            "example": "65e4decdd286b30065d54af9"
          },
          "userId": {
            "description": "User's id",
            "type": "string",
            "example": "66324a95b57fe63b73849210"
          },
          "accessToken": {
            "description": "User's access token",
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6..."
          },
          "refreshToken": {
            "description": "User's refresh token",
            "type": "string",
            "example": "SDFsdklfnsdjk23j4nSDF98sdf..."
          },
          "accessTokenValidUntil": {
            "description": "Shows till when user's access token is valid",
            "type": "string",
            "format": "date-time",
            "example": "2025-05-01T12:00:00.000Z"
          },
          "refreshTokenValidUntil": {
            "description": "Shows till when user's refresh token is valid",
            "type": "string",
            "format": "date-time",
            "example": "2025-05-31T12:00:00.000Z"
          }
        }
      }
    },
